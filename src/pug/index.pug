doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='张楠楠的个人主页，专注于智能家居应用开发与 AI Agent / RAG 项目实践。')
        meta(name='author', content='张楠楠')

        title 张楠楠 | 个人主页

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header
            header.py-5
                .container.px-5.pb-5
                    .row.gx-5.align-items-center
                        .col-xxl-5
                            // Header text content
                            .text-center.text-xxl-start
                                .badge.bg-gradient-primary-to-secondary.text-white.mb-4
                                    .text-uppercase 智能家居 &middot; 软件开发 &middot; AI 应用
                                .fs-3.fw-light.text-muted 你好，我是
                                h1.display-3.fw-bolder.mb-5
                                    span.text-gradient.d-inline 张楠楠
                                p.lead.fw-light.text-muted.mb-4 专注于智能家居应用开发，并持续探索 AI Agent 与 RAG 技术。
                                .d-grid.gap-3.d-sm-flex.justify-content-sm-center.justify-content-xxl-start.mb-3
                                    a.btn.btn-primary.btn-lg.px-5.py-3.me-sm-3.fs-6.fw-bolder(href='resume.html') 查看简历
                                    a.btn.btn-outline-dark.btn-lg.px-5.py-3.fs-6.fw-bolder(href='projects.html') 查看项目
                        .col-xxl-7
                            // Header profile picture
                            .d-flex.justify-content-center.mt-5.mt-xxl-0
                                .profile.bg-gradient-primary-to-secondary
                                    // TIP: For best results, use a photo with a transparent background like the demo example below
                                    // Watch a tutorial on how to do this on YouTube (link)
                                    img.profile-img(src='assets/profile.png', alt='...')
                                    .dots-1
                                        include includes/svg-dots.pug
                                    .dots-2
                                        include includes/svg-dots.pug
                                    .dots-3
                                        include includes/svg-dots.pug
                                    .dots-4
                                        include includes/svg-dots.pug

            // About Section
            section.bg-light.py-5
                .container.px-5
                    .row.gx-5.justify-content-center
                        .col-xxl-8
                            .text-center.my-5
                                h2.display-5.fw-bolder
                                    span.text-gradient.d-inline 关于我
                                p.lead.fw-light.mb-4 正在把想法做成真正可以运行的项目。
                                p.text-muted 我关注智能家居场景中的设备管理、场景联动和用户体验，也在学习知识库问答、Agent 工具调用等 AI 应用开发方法。
                                .d-flex.justify-content-center.fs-2.gap-4
                                    a.text-gradient(href='https://github.com/zhangnannanyds' aria-label='GitHub')
                                        i.bi.bi-github
                                    a.text-gradient(href='resume.html' aria-label='个人简历')
                                        i.bi.bi-file-earmark-person
                                    a.text-gradient(href='projects.html' aria-label='个人项目')
                                        i.bi.bi-kanban

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
