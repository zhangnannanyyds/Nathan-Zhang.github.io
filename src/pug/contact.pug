doctype html
html(lang='zh-CN')
    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='通过邮箱或 GitHub 联系张楠楠。')
        meta(name='author', content='张楠楠')
        title 联系 | 张楠楠

        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
        include includes/css.pug

    body.d-flex.flex-column.h-100.bg-light
        main.flex-shrink-0
            include includes/navbar.pug

            section.py-5
                .container.px-5.py-lg-5
                    .row.gx-5.justify-content-center
                        .col-lg-10.col-xl-9
                            .contact-panel.rounded-4.p-4.p-md-5
                                .row.align-items-center.g-5
                                    .col-lg-7
                                        p.section-kicker.mb-2 保持联系
                                        h1.display-5.fw-bolder.mb-3
                                            span.text-gradient.d-inline 一起交流 AI Agent 与软件开发
                                        p.lead.text-muted.mb-4 如果你对 RepoPilot、工具调用、安全边界或我的其他项目感兴趣，欢迎通过邮箱或 GitHub 联系我。
                                        .d-flex.flex-column.flex-sm-row.gap-3
                                            a.btn.btn-primary.btn-lg.px-4(href='mailto:1241812137@qq.com')
                                                i.bi.bi-envelope.me-2
                                                | 发送邮件
                                            a.btn.btn-outline-dark.btn-lg.px-4(href='https://github.com/zhangnannanyyds', target='_blank', rel='noreferrer')
                                                i.bi.bi-github.me-2
                                                | 访问 GitHub
                                    .col-lg-5
                                        .contact-card.bg-white.rounded-4.p-4
                                            .d-flex.align-items-center.mb-4
                                                .feature.bg-gradient-primary-to-secondary.text-white.rounded-3.me-3
                                                    i.bi.bi-envelope
                                                div
                                                    .small.text-muted 邮箱
                                                    a.fw-bolder.text-decoration-none(href='mailto:1241812137@qq.com') 1241812137@qq.com
                                            .d-flex.align-items-center.mb-4
                                                .feature.bg-gradient-primary-to-secondary.text-white.rounded-3.me-3
                                                    i.bi.bi-github
                                                div
                                                    .small.text-muted GitHub
                                                    a.fw-bolder.text-decoration-none(href='https://github.com/zhangnannanyyds', target='_blank', rel='noreferrer') @zhangnannanyyds
                                            button#copyEmail.btn.btn-light.w-100(type='button', data-email='1241812137@qq.com')
                                                i.bi.bi-clipboard.me-2
                                                span 复制邮箱地址

        include includes/footer.pug
        include includes/scripts.pug
