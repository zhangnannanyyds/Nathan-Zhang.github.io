doctype html
html(lang='zh-CN')
    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='张楠楠的教育背景、AI Agent 项目经验与技术能力。')
        meta(name='author', content='张楠楠')
        title 简历 | 张楠楠

        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
        include includes/css.pug

    body.d-flex.flex-column.h-100.bg-light
        main.flex-shrink-0
            include includes/navbar.pug

            .container.px-5.my-5
                .row.gx-5.justify-content-center
                    .col-lg-11.col-xl-10.col-xxl-9
                        .d-flex.flex-column.flex-md-row.align-items-md-end.justify-content-between.gap-3.mb-5
                            div
                                p.section-kicker.mb-2 个人简历
                                h1.display-5.fw-bolder.mb-2
                                    span.text-gradient.d-inline AI Agent / Python 开发
                                p.lead.text-muted.mb-0 数据科学与大数据技术本科生，关注工具调用、模型接入、安全边界与工程测试。
                            .d-flex.gap-2
                                a.btn.btn-primary.px-4.py-3(href='mailto:1241812137@qq.com')
                                    i.bi.bi-envelope.me-2
                                    | 联系我
                                a.btn.btn-outline-dark.px-4.py-3(href='https://github.com/zhangnannanyyds', target='_blank', rel='noreferrer')
                                    i.bi.bi-github.me-2
                                    | GitHub

                        section.mb-5
                            h2.text-primary.fw-bolder.mb-4 教育背景
                            .card.shadow-sm.border-0.rounded-4
                                .card-body.p-4.p-lg-5
                                    .row.align-items-center.g-4
                                        .col-md-4
                                            .resume-meta.rounded-4.p-4
                                                .text-primary.fw-bolder.mb-2 2023.09 - 2027.06
                                                .fw-bolder 江苏师范大学科文学院
                                                .small.text-muted 本科在读
                                        .col-md-8
                                            h3.h5.fw-bolder 数据科学与大数据技术
                                            p.text-muted.mb-0 相关课程：Python 程序设计、数据结构与算法、机器学习、推荐系统、数据库、Java 开发、网络空间安全。

                        section.mb-5
                            h2.text-primary.fw-bolder.mb-4 项目与实践
                            .timeline-stack
                                article.card.shadow-sm.border-0.rounded-4.mb-4
                                    .card-body.p-4.p-lg-5
                                        .d-flex.flex-column.flex-lg-row.justify-content-between.gap-3.mb-3
                                            div
                                                p.section-kicker.mb-1 个人项目
                                                h3.h4.fw-bolder.mb-1 RepoPilot 代码仓库学习与调试 Agent
                                            a.btn.btn-sm.btn-outline-primary.align-self-lg-start(href='https://github.com/zhangnannanyyds/repo-learning-agent', target='_blank', rel='noreferrer')
                                                i.bi.bi-github.me-2
                                                | 查看仓库
                                        ul.resume-list.text-muted.mb-0
                                            li 支持本地项目与 GitHub 仓库的项目识别、文件检索、按行读取、代码搜索、运行命令推断和报错诊断。
                                            li 基于 Agents SDK 组织工具调用，通过 OpenAI 兼容接口接入大模型服务，区分模型理解与工具数据访问职责。
                                            li 实现集中黑名单、敏感文件过滤、路径穿越与符号链接防护，并完成 55 项离线单元测试。
                                            li 提供会话历史、多仓库对比、访问额度状态和 Markdown 报告导出。

                                article.card.shadow-sm.border-0.rounded-4.mb-4
                                    .card-body.p-4.p-lg-5
                                        p.section-kicker.mb-1 团队项目
                                        h3.h4.fw-bolder.mb-3 HarmonyOS 智能家居应用
                                        ul.resume-list.text-muted.mb-0
                                            li 参与家庭、场景、消息和个人模块开发，完成登录注册、房间与设备管理、状态同步和场景执行流程。
                                            li 使用 AppStorage 实现按用户隔离的数据存储，通过 TCP Socket 与 MQTT 对接华为云 IoT。
                                            li 记录场景设备状态快照并处理冲突场景，支持多类设备的模拟控制与消息展示。

                                article.card.shadow-sm.border-0.rounded-4
                                    .card-body.p-4.p-lg-5
                                        p.section-kicker.mb-1 课程项目
                                        h3.h4.fw-bolder.mb-3 海底捞门店数据采集与可视化分析
                                        ul.resume-list.text-muted.mb-0
                                            li 使用 Python 和 Pandas 完成数据采集、去重、异常值处理与字段统一。
                                            li 围绕城市分布、评分和消费等维度开展统计与相关性分析，并使用 Matplotlib 形成可视化报告。

                        section.mb-5
                            h2.text-primary.fw-bolder.mb-4 企业实训
                            .card.shadow-sm.border-0.rounded-4
                                .card-body.p-4.p-lg-5
                                    .row.align-items-center.g-4
                                        .col-md-4
                                            .resume-meta.rounded-4.p-4
                                                .text-primary.fw-bolder.mb-2 2026.07 - 2026.10
                                                .fw-bolder 软通动力企业实训
                                                .small.text-muted 无锡中关村
                                        .col-md-8
                                            p.text-muted.mb-2 参与 HarmonyOS 应用与开发板实践，完成环境配置、设备连接、应用部署、日志查看和基础问题定位。
                                            p.text-muted.mb-0 围绕企业化项目完成任务拆解、过程记录、联调验证与结果汇报。

                        section.mb-5
                            .card.shadow-sm.border-0.rounded-4
                                .card-body.p-4.p-lg-5
                                    .row.g-5
                                        .col-lg-6
                                            .d-flex.align-items-center.mb-4
                                                .feature.bg-gradient-primary-to-secondary.text-white.rounded-3.me-3
                                                    i.bi.bi-tools
                                                h2.h4.fw-bolder.mb-0 核心技能
                                            .skill-grid
                                                span.skill-item Agents SDK
                                                span.skill-item Tool Calling
                                                span.skill-item GitHub REST API
                                                span.skill-item Python unittest
                                                span.skill-item 安全与权限控制
                                                span.skill-item Prompt 约束设计
                                        .col-lg-6
                                            .d-flex.align-items-center.mb-4
                                                .feature.bg-gradient-primary-to-secondary.text-white.rounded-3.me-3
                                                    i.bi.bi-code-slash
                                                h2.h4.fw-bolder.mb-0 技术栈
                                            .skill-grid
                                                span.skill-item Python
                                                span.skill-item Java
                                                span.skill-item ArkTS / ArkUI
                                                span.skill-item Pandas
                                                span.skill-item Linux
                                                span.skill-item MQTT / TCP Socket

                        section
                            .card.shadow-sm.border-0.rounded-4
                                .card-body.p-4.p-lg-5
                                    h2.h4.fw-bolder.mb-3 证书
                                    p.text-muted.mb-0 全国大学英语四级（CET-4） · 鸿蒙应用开发者基础认证

        include includes/footer.pug
        include includes/scripts.pug
